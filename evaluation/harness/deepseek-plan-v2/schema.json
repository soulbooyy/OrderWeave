{
  "$defs": {
    "BillingRead": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "quote": {
          "description": "Verbatim user span. For conditional actions use exactly the action without if, then, otherwise, or terminal punctuation.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "depends_on": {
          "description": "Direct prerequisites only. [] for an independent action.",
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Depends On",
          "type": "array"
        },
        "target": {
          "description": "Literal identifier from the span. For order reads and order transactions use the order ID, for variants lists the product ID, for a specification the item/variant ID. Use an empty string for a target supplied by predecessors.",
          "maxLength": 128,
          "title": "Target",
          "type": "string"
        },
        "run_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/Branch"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required on both conditional actions. Omit on unconditional actions."
        },
        "kind": {
          "const": "billing_lookup",
          "title": "Kind",
          "type": "string"
        },
        "output": {
          "enum": [
            "order_id",
            "status",
            "purchased_item_count",
            "item_ids",
            "payment_type"
          ],
          "title": "Output",
          "type": "string"
        }
      },
      "required": [
        "id",
        "quote",
        "depends_on",
        "target",
        "kind",
        "output"
      ],
      "title": "BillingRead",
      "type": "object"
    },
    "Branch": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "description": "Direct predecessor providing the tested fact.",
