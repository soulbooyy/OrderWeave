          "title": "Source",
          "type": "string"
        },
        "branch": {
          "description": "Polarity of this exact action in the original conditional.",
          "enum": [
            "then",
            "else"
          ],
          "title": "Branch",
          "type": "string"
        }
      },
      "required": [
        "source",
        "branch"
      ],
      "title": "Branch",
      "type": "object"
    },
